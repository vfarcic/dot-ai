{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases"
  ],
  "schedule": ["before 9am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "assignees": ["@vfarcic"],
  "pinDigests": true,
  "packageRules": [
    {
      "matchFileNames": ["docker-compose-dot-ai.yaml"],
      "pinDigests": false,
      "description": "Keep using :latest tags in docker-compose-dot-ai.yaml"
    },
    {
      "matchFileNames": ["**/Dockerfile", "**/Dockerfile-*"],
      "pinDigests": false,
      "description": "Disable digest pinning for multi-architecture base images. SHA256 digests pin to a single architecture and break ARM/ARM64 support."
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackageNames": ["@types/*"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "groupName": "TypeScript definitions"
    },
    {
      "matchPackageNames": ["jest", "@types/jest", "ts-jest"],
      "groupName": "Jest packages"
    },
    {
      "matchPackageNames": ["eslint*", "prettier", "@typescript-eslint/*"],
      "groupName": "Linting tools"
    },
    {
      "matchPackageNames": ["@kubernetes/client-node"],
      "reviewersFromCodeOwners": true,
      "labels": ["kubernetes", "major-update"]
    },
    {
      "matchManagers": ["devbox"],
      "groupName": "Devbox packages",
      "labels": ["devbox"]
    },
    {
      "matchManagers": ["devbox", "github-actions"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "description": "Automerge devbox and GitHub Actions updates below major. Major bumps stay manual. CI is skipped on Renovate PRs ([skip ci]), so there are no tests to gate on."
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "prHourlyLimit": 3,
  "prConcurrentLimit": 5,
  "rebaseWhen": "conflicted",
  "commitMessageSuffix": " [skip ci]"
} 